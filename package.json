{
  "name": "nomeinteresa",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that hides news articles whose headlines match your keywords, on the sites you choose.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "content-filter",
    "news",
    "keywords"
  ],
  "author": "Jose Fuentes (https://www.linkedin.com/in/josefuentes4096/)",
  "license": "0BSD",
  "homepage": "https://github.com/josefuentes4096/nomeinteresa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josefuentes4096/nomeinteresa.git"
  },
  "bugs": {
    "url": "https://github.com/josefuentes4096/nomeinteresa/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node --test tests/e2e/filter.e2e.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "package": "node scripts/package.js",
    "store-assets": "node scripts/store-assets.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
